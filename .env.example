MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=ledger
MONGODB_DB=ledger

# Public origin used in sign-in messages (defaults to request origin).
APP_ORIGIN=http://localhost:3000

# Atlas IP whitelist (0.0.0.0/0) allows any IP — separate from DNS issues.
# Bun on Windows cannot resolve mongodb+srv DNS; the app auto-converts to a
# direct connection string at startup.
